// Alright — let’s make the difference between === (structural equality) and == (typeclass equality) really clear by using an example with unknown (x) bits.
// In simulation, x means “unknown” and can appear in uninitialized registers or during certain logic conditions.

// Example: === vs == with unknown bits
// Note:   Numeric literals with X or Z not supported

// Ah, I see what’s happening — Bluespec does not allow you to directly write x or z in numeric literals like Verilog does.
// That’s why you’re getting:
// Numeric literals with X or Z not supported

// In BSV, if you want to simulate unknown bits, you have to assign them at runtime using ? (the “don’t care” / unknown initializer) or by using fromInteger with masking, rather than putting x in the literal.

// Here’s a fixed version of the example that works in Bluespec:

package Tb;

(* synthesize *)
module mkTb();

   Bit#(4) a = 4'b1011;
   Bit#(4) b = 4'b1011;
   Bit#(4) c = 4'b1011;

   // Overwrite one bit with an unknown ('?')
   a[1] = ?;  // Set bit 1 to unknown
   b[1] = ?;  // Same unknown position in b

   // Initialize values in an initial rule
   rule init;

      $display("a = %b, b = %b, c = %b", a, b, c);
      
      // Structural equality
      if (a matches 4'b10?1)
         $display("a === b : TRUE (bit-by-bit match, including unknowns)");
      else
         $display("a === b : FALSE");

      // Typeclass equality
      if (a == b)
         $display("a == b  : TRUE");
      else
         $display("a == b  : FALSE (unknowns cause mismatch)");

      // Compare with fully known value
      if (a matches 4'b1011)
         $display("a === c : TRUE");
      else
         $display("a === c : FALSE");

      if (a == c)
         $display("a == c  : TRUE");
      else
         $display("a == c  : FALSE");
      
      $finish;
      
   endrule

endmodule

endpackage


// Key changes:

// Used ? to assign an unknown to a specific bit.
// Avoided 4'b10x1 literal, which is illegal in BSV.
// This will work in Bluesim and show x in the simulation output.
